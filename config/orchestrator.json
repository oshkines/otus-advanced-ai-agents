{
  "version": "0.2.0",
  "core": {
    "name": "ai-dev-orchestrator-core",
    "runtime": "cpp20",
    "target_platform": "windows-11-msvc2022",
    "log_level": "info",
    "timezone": "Europe/Moscow",
    "tick_interval_sec": 30
  },
  "workers": [
    {
      "id": "vacancy_scanner",
      "script": "agents/vacancy_scanner.py",
      "interpreter": "python",
      "enabled": false,
      "schedule": "0 */6 * * *",
      "timeout_sec": 180,
      "stdout_format": "json",
      "env_required": [],
      "args": ["--tags", "C++, 1C, Remote"]
    },
    {
      "id": "telegram_watcher",
      "script": "agents/telegram_watcher.py",
      "interpreter": "python",
      "enabled": false,
      "schedule": "*/5 * * * *",
      "timeout_sec": 120,
      "stdout_format": "json",
      "env_required": ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID"],
      "args": []
    },
    {
      "id": "email_watcher",
      "script": "agents/email_watcher.py",
      "interpreter": "python",
      "enabled": false,
      "schedule": "*/10 * * * *",
      "timeout_sec": 120,
      "stdout_format": "json",
      "env_required": ["EMAIL_IMAP_HOST", "EMAIL_IMAP_USER", "EMAIL_IMAP_PASSWORD"],
      "args": []
    },
    {
      "id": "rzhd_watcher",
      "script": "agents/rzhd_watcher.py",
      "interpreter": "python",
      "enabled": false,
      "schedule": "0 */2 * * *",
      "timeout_sec": 180,
      "stdout_format": "json",
      "env_required": ["RZHD_API_TOKEN"],
      "args": ["--from", "SPB", "--to", "MSK", "--car-types", "coupe,platzkart,sv", "--purpose", "university-holidays"]
    }
  ],
  "storage": {
    "sqlite": {
      "path": "data/cache.db",
      "dedup_window_days": 30,
      "tables": ["processed_messages", "processed_emails"]
    }
  },
  "ui": {
    "status_panel": "src/status_panel.html",
    "auto_open": false,
    "dashboard": {
      "framework": "nextjs-tailwind4",
      "app_dir": "web",
      "refresh_interval_sec": 15,
      "navigation": [
        {
          "id": "email",
          "label_key": "nav.email",
          "icon": "mail",
          "order": 10,
          "worker_ids": ["email_watcher"],
          "storage_table": "processed_emails"
        },
        {
          "id": "vacancies",
          "label_key": "nav.vacancies",
          "icon": "briefcase",
          "order": 20,
          "worker_ids": ["vacancy_scanner"],
          "storage_table": null
        },
        {
          "id": "rzhd",
          "label_key": "nav.rzhd",
          "icon": "train",
          "order": 30,
          "worker_ids": ["rzhd_watcher"],
          "storage_table": null
        }
      ]
    }
  },
  "e2e": {
    "runner": "python-playwright",
    "test_script": "tests/browser_test.py",
    "screenshot": ".planning/screenshots/green_e2e_test.png"
  }
}
