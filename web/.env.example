# Шаблон переменных окружения фронтенда Next.js (web/).
# Скопируйте в web/.env.local и при необходимости измените адрес API.

# Backend FastAPI (api/main.py), префикс /api/v1 подставляется клиентом.
# Локальная разработка: uvicorn --host 127.0.0.1 --port 8000.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Рабочий стенд (пример): адрес, с которого открывается фронтенд, и тот же
# хост API. Origin фронтенда должен быть разрешён в API_CORS_ORIGINS на бэкенде.
# NEXT_PUBLIC_API_URL=http://82.148.236.43:8000
